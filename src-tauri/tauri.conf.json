{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "game-damas",
  "version": "0.1.0",
  "identifier": "com.ebraimsambo.game-damas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Damas",
        "width": 890,
        "height": 605,
        "minWidth": 890,
        "minHeight": 605,
        "maximizable": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icons-app/favicon-32x32.png",
      "icons/icons-app/apple-touch-icon.png",
      "icons/icons-app/android-chrome-192x192.png",
      "icons/icons-app/android-chrome-512x512.png",
      "icons/icons-app/favicon.ico"
    ]
  }
}